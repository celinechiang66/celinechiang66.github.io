      <div class="flex items-center gap-2 text-xs tracking-[0.22em] uppercase text-offwhite/55">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-peach/80"></span>
        <span>Interactive Constellation</span>
      </div>
      <nav aria-label="Quick Star Links" class="hidden md:flex items-center gap-5 text-xs tracking-wider text-offwhite/65">
        <button onclick="navigateTo('about')" class="hover:text-peach transition-colors cursor-pointer">About Me</button>
        <button onclick="navigateTo('projects')" class="hover:text-peach transition-colors cursor-pointer">Projects</button>
        <button onclick="navigateTo('skills')" class="hover:text-peach transition-colors cursor-pointer">Skills</button>
        <button onclick="navigateTo('experience')" class="hover:text-peach transition-colors cursor-pointer">Experience</button>
        <button onclick="navigateTo('contact')" class="hover:text-peach transition-colors cursor-pointer">Contact</button>
      </nav>
    </header>

    <!-- INTERACTIVE BIG DIPPER CONSTELLATION STAGE -->
    <!-- Positioned in the upper-left to upper-right sky just like the artwork -->
