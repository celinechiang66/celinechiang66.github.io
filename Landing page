  </main>

  <!-- ===================================================================== -->
  <!-- SUBPAGES CONTAINER (OPENED WHEN CLICKING ANY CONSTELLATION STAR)      -->
  <!-- ===================================================================== -->
  <div id="subpage-shell" class="hidden min-h-screen w-full subpage-sky relative overflow-x-hidden">
    
    <!-- Ambient Stars on Subpages -->
    <div id="subpage-starfield" class="fixed inset-0 z-0 pointer-events-none"></div>

    <!-- Sticky Glass Constellation Navigation Bar -->
    <nav aria-label="Portfolio Constellation Navigation" class="sticky top-0 z-30 border-b border-offwhite/10 bg-[#080b1c]/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3.5 sm:px-8">
        
        <!-- Back to Night Sky Button -->
        <button
          onclick="navigateTo('home')"
          class="group inline-flex items-center gap-2 rounded-full border border-offwhite/15 bg-white/5 px-4 py-2 text-xs sm:text-sm font-medium text-offwhite transition-all hover:border-peach/60 hover:bg-peach/15 hover:text-peach cursor-pointer"
        >
          <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
