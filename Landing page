          style="left: 60.5%; top: 14.5%;"
          class="absolute -translate-x-1/2 -translate-y-1/2 pointer-events-none flex items-center justify-center"
          aria-hidden="true"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/10">
            <span class="h-2.5 w-2.5 rounded-full bg-[#fffdf7] shadow-[0_0_16px_5px_rgba(255,250,235,0.8)]"></span>
          </span>
        </div>

        <!-- STAR 5: CONTACT (Far-Right Handle Tip Star near Reaching Hand) -->
        <button
          onclick="navigateTo('contact')"
          onmouseenter="highlightConstellation(true)"
          onmouseleave="highlightConstellation(false)"
          style="left: 75.5%; top: 23.5%;"
          class="star-trigger group absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center p-3 cursor-pointer focus:outline-none"
          aria-label="Open Contact page"
        >
          <span class="relative flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-white/15 transition-transform duration-300 group-hover:scale-125">
            <span class="star-node-core h-3.5 w-3.5 sm:h-4 sm:w-4 rounded-full bg-[#ffffff]" style="animation-delay: 2.3s;"></span>
          </span>
          <span class="star-label mt-1.5 sm:mt-2 font-serif italic text-base sm:text-xl md:text-2xl tracking-wide text-offwhite whitespace-nowrap">
            Contact
          </span>
        </button>

      </div>
