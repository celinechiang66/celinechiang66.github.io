  <!-- Case Study Preview Modal -->
  <div id="project-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#080b1c]/80 backdrop-blur-md p-4">
    <div class="glass-card max-w-lg w-full rounded-3xl p-6 sm:p-8 border border-peach/30 relative animate-[pageFadeIn_0.3s_ease]">
      <button onclick="closeProjectModal()" class="absolute top-5 right-5 rounded-full bg-white/10 p-2 text-offwhite/70 hover:text-peach cursor-pointer" aria-label="Close modal">
        ✕
      </button>
      <span class="text-xs uppercase tracking-widest text-peach">Case Study Highlight</span>
      <h3 id="modal-project-title" class="mt-2 font-serif italic text-2xl sm:text-3xl text-offwhite">Project Title</h3>
      <p id="modal-project-desc" class="mt-4 text-sm leading-relaxed text-offwhite/80">Project details go here.</p>
      <div class="mt-6 flex justify-end gap-3">
        <button onclick="closeProjectModal()" class="rounded-2xl border border-offwhite/15 px-4 py-2 text-xs font-medium text-offwhite hover:border-peach/50 cursor-pointer">Close</button>
        <button onclick="closeProjectModal(); showToast('Opening live interactive demo...')" class="rounded-2xl bg-peach px-5 py-2 text-xs font-semibold text-[#090c1e] cursor-pointer">Launch Live Demo ↗</button>
      </div>
    </div>
