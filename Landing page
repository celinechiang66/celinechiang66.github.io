      <div id="constellation-wrapper" class="relative w-full max-w-[920px] aspect-[16/9] sm:aspect-[16/8.2] min-h-[290px] sm:min-h-[340px]">
        
        <!-- SVG Dotted Constellation Lines Connecting the 7 Stars of the Big Dipper -->
        <!-- Coordinates match the exact 7-star Big Dipper geometry:
             1: (13%, 17%) -> About Me
             2: (14.5%, 54%) -> Projects
             3: (32.5%, 60%) -> Experience
             4: (33.5%, 29%) -> Skills
             5: (47.5%, 23%) -> Decorative Handle Star 1
             6: (60.5%, 14.5%) -> Decorative Handle Star 2
             7: (75.5%, 23.5%) -> Contact
        -->
        <svg viewBox="0 0 1000 500" preserveAspectRatio="none" class="absolute inset-0 h-full w-full pointer-events-none overflow-visible">
          <defs>
            <filter id="lineGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="2" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>
          <!-- Bowl + Handle Polyline -->
          <polyline
            class="constellation-line transition-all duration-500"
            points="130,85 145,270 325,300 335,145 130,85"
            fill="none"
            stroke="rgba(245, 236, 230, 0.48)"
            stroke-width="2.1"
            stroke-dasharray="4 8"
            stroke-linecap="round"
            filter="url(#lineGlow)"
          />
          <polyline
            class="constellation-line transition-all duration-500"
            points="335,145 475,115 605,72 755,118"
            fill="none"
            stroke="rgba(245, 236, 230, 0.48)"
            stroke-width="2.1"
            stroke-dasharray="4 8"
            stroke-linecap="round"
            filter="url(#lineGlow)"
          />
        </svg>

        <!-- STAR 1: ABOUT ME (Top-Left Bowl Star) -->
        <button
          onclick="navigateTo('about')"
          onmouseenter="highlightConstellation(true)"
          onmouseleave="highlightConstellation(false)"
          style="left: 13%; top: 17%;"
          class="star-trigger group absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center p-3 cursor-pointer focus:outline-none"
          aria-label="Open About Me page"
        >
