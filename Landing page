  <!-- ===================================================================== -->
  <!-- JAVASCRIPT: STARFIELD, GRASS BLADES, ROUTING & INTERACTIONS           -->
  <!-- ===================================================================== -->
  <script>
    const PAGE_LABELS = {
      home: 'Returning to the Night Sky...',
      about: 'Following Dubhe to About Me...',
      projects: 'Following Merak to Projects...',
      skills: 'Following Megrez to Skills...',
      experience: 'Following Phecda to Experience...',
      contact: 'Following Alkaid to Contact...'
    };

    /**
     * Generate realistic twinkling stars for both the landing sky and subpages
     */
    function populateStarfield(containerId, count, maxTopPercent) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';

      for (let i = 0; i < count; i++) {
        const star = document.createElement('span');
        star.className = 'bg-star';
        const size = Math.random() < 0.8 ? (Math.random() * 1.8 + 1) : (Math.random() * 2.5 + 2);
        const left = Math.random() * 100;
        const top = Math.random() * maxTopPercent;
        const dur = (Math.random() * 3.5 + 2.5).toFixed(2);
        const delay = (Math.random() * 4).toFixed(2);
        const minOp = (Math.random() * 0.25 + 0.1).toFixed(2);
        const maxOp = (Math.random() * 0.45 + 0.5).toFixed(2);

        star.style.width = `${size}px`;
        star.style.height = `${size}px`;
        star.style.left = `${left}%`;
        star.style.top = `${top}%`;
        star.style.setProperty('--dur', `${dur}s`);
        star.style.setProperty('--delay', `${delay}s`);
        star.style.setProperty('--min-op', minOp);
        star.style.setProperty('--max-op', maxOp);

        container.appendChild(star);
      }
    }

    /**
     * Generate delicate silhouette blades of grass along the SVG rolling hillside crest
     */
    function populateHillGrass() {
      const grassGroup = document.getElementById('hill-grass-blades');
      if (!grassGroup) return;

      let paths = '';
      // Sample X from 0 to 1440 every 7px
      for (let x = 2; x < 1440; x += 6.5) {
        // Approximate Y along the hill curve
        let y;
        if (x < 780) {
          const t = x / 780;
          y = 492 - (28 * Math.pow(t, 1.35));
        } else if (x < 1175) {
          const t = (x - 780) / (1175 - 780);
          y = 464 - (16 * Math.sin(t * Math.PI * 0.65));
        } else {
          const t = (x - 1175) / (1440 - 1175);
          y = 448 + (20 * Math.pow(t, 1.2));
        }

        const bladeHeight = 5 + Math.random() * 9;
        const lean = (Math.random() - 0.35) * 6;
        paths += `M ${x.toFixed(1)} ${(y + 3).toFixed(1)} L ${(x + lean).toFixed(1)} ${(y - bladeHeight).toFixed(1)} L ${(x + 2.2).toFixed(1)} ${(y + 3).toFixed(1)} Z `;
      }

      const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pathEl.setAttribute('d', paths);
      grassGroup.appendChild(pathEl);
    }

    /**
     * Highlight constellation dotted lines on star hover
     */
    function highlightConstellation(active) {
      const wrapper = document.getElementById('constellation-wrapper');
      if (!wrapper) return;
      if (active) {
        wrapper.classList.add('constellation-active');
      } else {
        wrapper.classList.remove('constellation-active');
      }
    }

    /**
     * Smooth Starlight Page Transition & Routing
     */
    function navigateTo(pageKey, pushHistory = true) {
      const validPages = ['home', 'about', 'projects', 'skills', 'experience', 'contact'];
      const target = validPages.includes(pageKey) ? pageKey : 'home';

      const veil = document.getElementById('transition-veil');
      const label = document.getElementById('transition-label');
      label.textContent = PAGE_LABELS[target] || 'Navigating...';

      veil.classList.add('active');

      setTimeout(() => {
        renderPage(target);
        if (pushHistory) {
          window.location.hash = target === 'home' ? '' : target;
        }
        window.scrollTo({ top: 0, behavior: 'instant' });

        setTimeout(() => {
          veil.classList.remove('active');
        }, 180);
      }, 320);
    }

    /**
     * Render either the Landing Night Sky or the selected Subpage
     */
    function renderPage(target) {
      const homeView = document.getElementById('view-home');
      const subpageShell = document.getElementById('subpage-shell');
      const subpageViews = document.querySelectorAll('.subpage-view');
      const navPills = document.querySelectorAll('.sub-nav-pill');

      if (target === 'home') {
        subpageShell.classList.add('hidden');
        homeView.classList.remove('hidden');
        homeView.classList.add('view-enter');
      } else {
        homeView.classList.add('hidden');
        subpageShell.classList.remove('hidden');

        subpageViews.forEach(view => {
          view.classList.add('hidden');
          view.classList.remove('view-enter');
        });

        const activeSection = document.getElementById(`page-${target}`);
        if (activeSection) {
          activeSection.classList.remove('hidden');
          activeSection.classList.add('view-enter');
        }

        // Update active state on top constellation mini-nav
        navPills.forEach(pill => {
          if (pill.dataset.nav === target) {
            pill.classList.add('bg-peach', 'text-[#090c1e]', 'font-semibold', 'shadow-[0_0_16px_rgba(232,168,124,0.45)]');
            pill.classList.remove('text-offwhite/75', 'hover:text-peach', 'hover:bg-white/5');
          } else {
            pill.classList.remove('bg-peach', 'text-[#090c1e]', 'font-semibold', 'shadow-[0_0_16px_rgba(232,168,124,0.45)]');
            pill.classList.add('text-offwhite/75', 'hover:text-peach', 'hover:bg-white/5');
          }
        });
      }
    }

    /**
     * Filter Projects by Category
     */
    function filterProjects(category) {
      const cards = document.querySelectorAll('.project-card');
      const buttons = document.querySelectorAll('.filter-btn');

      buttons.forEach(btn => {
        if (btn.dataset.filter === category) {
          btn.classList.add('bg-peach', 'text-[#090c1e]', 'font-semibold');
          btn.classList.remove('border', 'border-offwhite/15', 'bg-white/5', 'text-offwhite/80');
        } else {
          btn.classList.remove('bg-peach', 'text-[#090c1e]', 'font-semibold');
          btn.classList.add('border', 'border-offwhite/15', 'bg-white/5', 'text-offwhite/80');
        }
      });

      cards.forEach(card => {
        const cats = card.dataset.category || '';
        if (category === 'all' || cats.includes(category)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    /**
     * Case Study Modal Controls
     */
    function openProjectModal(title, description) {
      document.getElementById('modal-project-title').textContent = title;
      document.getElementById('modal-project-desc').textContent = description;
      const modal = document.getElementById('project-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeProjectModal() {
      const modal = document.getElementById('project-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    /**
     * Copy Email Address (Safe clipboard fallback for iframes)
     */
    function copyEmail() {
      const email = document.getElementById('email-text').textContent;
      const tempInput = document.createElement('input');
      tempInput.value = email;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        showToast('Copied hello@celinechiang.design to clipboard!');
      } catch (err) {
        showToast('Email: hello@celinechiang.design');
      }
      document.body.removeChild(tempInput);
    }

    /**
     * Contact Form Submission Handler
     */
    function handleContactSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('sender-name').value.trim();
      showToast(`Thank you, ${name || 'friend'}! Your message has been sent.`);
      event.target.reset();
    }

    /**
     * Custom Non-Blocking Toast Notification
     */
    let toastTimeout;
    function showToast(message) {
      const box = document.getElementById('toast-box');
      const msg = document.getElementById('toast-message');
      msg.textContent = message;

      box.classList.remove('hidden');
      requestAnimationFrame(() => {
        box.classList.remove('translate-y-4', 'opacity-0');
      });

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        box.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => box.classList.add('hidden'), 300);
      }, 3400);
    }

    // Initialize on Window Load & Listen for Browser Back/Forward Hash Changes
    window.addEventListener('DOMContentLoaded', () => {
      populateStarfield('home-starfield', 85, 76);
      populateStarfield('subpage-starfield', 55, 95);
      populateHillGrass();

      const initialHash = window.location.hash.replace('#', '');
      if (initialHash && PAGE_LABELS[initialHash]) {
        renderPage(initialHash);
      } else {
        renderPage('home');
      }
    });

    window.addEventListener('hashchange', () => {
      const hashTarget = window.location.hash.replace('#', '') || 'home';
      renderPage(hashTarget);
    });
  </script>
