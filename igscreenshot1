          onclick="navigateTo('home')"
          class="group inline-flex items-center gap-2 rounded-full border border-offwhite/15 bg-white/5 px-4 py-2 text-xs sm:text-sm font-medium text-offwhite transition-all hover:border-peach/60 hover:bg-peach/15 hover:text-peach cursor-pointer"
