<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Celine Chiang — Personal Portfolio</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Lora (italic serif for stars & headings) + Inter / Plus Jakarta Sans (clean UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
            serif: ['Lora', 'Georgia', 'serif'],
          },
          colors: {
            midnight: '#090c1e',
            twilight: '#1e2144',
            dusk: '#4b4875',
            peach: '#e8a87c',
            offwhite: '#f5ece6',
          }
        }
      }
    };
  </script>

  <style>
    /* Custom Animations & Atmospheric Effects */
    :root {
      --sky-top: #090c1e;
      --sky-upper: #171b3a;
      --sky-mid: #3b3a66;
      --sky-lower: #7b6082;
      --sky-horizon-1: #d48c84;
      --sky-horizon-2: #f2be9f;
    }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background-color: #090c1e;
      color: #f5ece6;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Full Twilight Gradient */
    .twilight-sky {
      background: linear-gradient(
        180deg,
        #080b1c 0%,
        #131736 24%,
        #2d2e59 48%,
        #68557a 70%,
        #c58482 86%,
        #f2be9f 100%
      );
    }

    /* Subpage Deep Night Sky Background */
    .subpage-sky {
      background: radial-gradient(circle at 80% 15%, rgba(104, 85, 122, 0.28) 0%, transparent 45%),
                  radial-gradient(circle at 15% 85%, rgba(232, 168, 124, 0.14) 0%, transparent 50%),
                  linear-gradient(180deg, #080b1c 0%, #111530 55%, #1d1f42 100%);
    }

    /* Background Twinkling Stars */
    @keyframes twinkle {
      0%, 100% { opacity: var(--min-op, 0.25); transform: scale(0.9); }
      50% { opacity: var(--max-op, 0.95); transform: scale(1.15); }
    }

    .bg-star {
      position: absolute;
      border-radius: 9999px;
      background-color: #fffaf0;
      pointer-events: none;
      animation: twinkle var(--dur, 4s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }

    /* Shooting Star Keyframes */
    @keyframes shoot {
      0% {
        opacity: 0;
        transform: translate3d(0, 0, 0) rotate(-28deg) scaleX(0.3);
      }
      12% {
        opacity: 1;
        transform: translate3d(-60px, 32px, 0) rotate(-28deg) scaleX(1);
      }
      100% {
        opacity: 0;
        transform: translate3d(-420px, 225px, 0) rotate(-28deg) scaleX(0.2);
      }
    }

    .shooting-star {
      position: absolute;
      width: 130px;
      height: 1.5px;
      background: linear-gradient(90deg, rgba(255, 250, 240, 0.95), rgba(242, 190, 159, 0.35), transparent);
      border-radius: 9999px;
      filter: drop-shadow(0 0 6px rgba(255, 250, 240, 0.85));
      animation: shoot 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Interactive Constellation Star Glow */
    @keyframes starPulse {
      0%, 100% {
        box-shadow: 0 0 14px 4px rgba(255, 250, 235, 0.75),
                    0 0 34px 12px rgba(255, 236, 200, 0.35),
                    0 0 60px 22px rgba(232, 168, 124, 0.16);
      }
      50% {
        box-shadow: 0 0 18px 6px rgba(255, 252, 240, 0.95),
                    0 0 44px 16px rgba(255, 236, 200, 0.5),
                    0 0 75px 28px rgba(232, 168, 124, 0.25);
      }
    }

    .star-node-core {
      animation: starPulse 3.6s ease-in-out infinite;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.3s ease;
    }

    .star-trigger:hover .star-node-core,
    .star-trigger:focus-visible .star-node-core {
      transform: scale(1.42);
      background-color: #ffffff;
      box-shadow: 0 0 22px 8px rgba(255, 255, 255, 1),
                  0 0 55px 22px rgba(242, 190, 159, 0.7),
                  0 0 90px 35px rgba(232, 168, 124, 0.4);
    }

    .star-trigger:hover .star-label,
    .star-trigger:focus-visible .star-label {
      color: #f8d0b0;
      transform: translateY(3px) scale(1.06);
      text-shadow: 0 0 18px rgba(242, 190, 159, 0.85);
    }

    .star-label {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease, text-shadow 0.3s ease;
      text-shadow: 0 2px 12px rgba(9, 12, 30, 0.85);
    }

    /* Subtle Dash Flow on Constellation Lines when hovered */
    @keyframes dashFlow {
      to {
        stroke-dashoffset: -24;
      }
    }

    .constellation-active .constellation-line {
      stroke: rgba(255, 248, 235, 0.85);
      animation: dashFlow 1.8s linear infinite;
    }

    /* Gentle Hair & Dress Breeze Sway */
    @keyframes breezeSway {
      0%, 100% { transform: rotate(0deg) translateX(0px); }
      50% { transform: rotate(1.4deg) translateX(2px); }
    }

    .wind-sway {
      transform-origin: 79% 68%;
      animation: breezeSway 5.5s ease-in-out infinite;
    }

    /* Starlight Warp / Page Transition Overlay */
    #transition-veil {
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #transition-veil.active {
      opacity: 1;
      pointer-events: all;
    }

    /* Page View Fade-Up Entrance */
    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .view-enter {
      animation: pageFadeIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Glassmorphism Cards for Subpages */
    .glass-card {
      background: rgba(20, 24, 52, 0.62);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(245, 236, 230, 0.12);
      box-shadow: 0 18px 40px -15px rgba(4, 6, 18, 0.7);
    }

    .glass-card-hover {
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card-hover:hover {
      transform: translateY(-4px);
      border-color: rgba(232, 168, 124, 0.42);
      box-shadow: 0 22px 45px -12px rgba(232, 168, 124, 0.14);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #080b1c;
    }
    ::-webkit-scrollbar-thumb {
      background: #2f335c;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #e8a87c;
    }
  </style>
</head>
<body class="antialiased selection:bg-peach/30 selection:text-offwhite">

  <!-- Starlight Burst Transition Overlay -->
