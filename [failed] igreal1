                class="w-full rounded-2xl bg-gradient-to-r from-[#e8a87c] to-[#d48c84] px-6 py-3.5 text-sm font-semibold text-[#090c1e] shadow-lg shadow-peach/20 transition-transform hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
