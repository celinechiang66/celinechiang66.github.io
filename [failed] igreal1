  <!-- ===================================================================== -->
  <!-- JAVASCRIPT: STARFIELD, PROCEDURAL GRASS ON HILL BEZIER, NAVIGATION    -->
  <!-- ===================================================================== -->
  <script>
    // 1. Generate Procedural Twinkling Starfields for Landing Page & Subpages
    function populateStarfield(containerId, count) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const fragment = document.createDocumentFragment();

      for (let i = 0; i < count; i++) {
        const star = document.createElement('span');
        star.className = 'bg-star';

        const size = Math.random() < 0.82 ? (Math.random() * 1.6 + 1) : (Math.random() * 2.2 + 2.2);
        const left = Math.random() * 100;
        // Keep stars slightly denser in upper 78% of sky
        const top = Math.pow(Math.random(), 0.85) * 86;
        const dur = (Math.random() * 4.5 + 2.5).toFixed(2) + 's';
        const delay = (Math.random() * 5).toFixed(2) + 's';
        const minOp = (Math.random() * 0.22 + 0.12).toFixed(2);
        const maxOp = (Math.random() * 0.45 + 0.55).toFixed(2);

        star.style.width = `${size}px`;
        star.style.height = `${size}px`;
        star.style.left = `${left}%`;
        star.style.top = `${top}%`;
        star.style.setProperty('--dur', dur);
        star.style.setProperty('--delay', delay);
        star.style.setProperty('--min-op', minOp);
        star.style.setProperty('--max-op', maxOp);

        fragment.appendChild(star);
      }
      container.appendChild(fragment);
    }

    // 2. Periodic Subtle Shooting Star on Landing Sky
    function triggerShootingStar() {
      const container = document.getElementById('shooting-star-container');
      const homeView = document.getElementById('view-home');
      if (!container || homeView.classList.contains('hidden')) return;

      const meteor = document.createElement('div');
      meteor.className = 'shooting-star';
      meteor.style.left = `${55 + Math.random() * 38}%`;
      meteor.style.top = `${6 + Math.random() * 26}%`;
      container.appendChild(meteor);

      setTimeout(() => {
        meteor.remove();
      }, 1700);
    }

    // 3. Exact Quadratic Bezier Evaluator for Hill Curve:
    // M 0 492 Q 420 486, 780 464 Q 1060 444, 1175 448 Q 1310 453, 1440 468
    function getHillYAtX(x) {
      function solveQuadBezierY(xTarget, x0, y0, cx, cy, x1, y1) {
        const a = x0 - 2 * cx + x1;
        const b = 2 * (cx - x0);
        const c = x0 - xTarget;
        let t = 0.5;
        if (Math.abs(a) < 1e-6) {
          t = (xTarget - x0) / (x1 - x0);
        } else {
          const disc = Math.max(0, b * b - 4 * a * c);
          const t1 = (-b + Math.sqrt(disc)) / (2 * a);
          const t2 = (-b - Math.sqrt(disc)) / (2 * a);
          t = (t1 >= -0.001 && t1 <= 1.001) ? t1 : t2;
        }
        t = Math.max(0, Math.min(1, t));
        const oneMinusT = 1 - t;
        return oneMinusT * oneMinusT * y0 + 2 * oneMinusT * t * cy + t * t * y1;
      }

      if (x <= 780) {
        return solveQuadBezierY(x, 0, 492, 420, 486, 780, 464);
      } else if (x <= 1175) {
        return solveQuadBezierY(x, 780, 464, 1060, 444, 1175, 448);
      } else {
        return solveQuadBezierY(x, 1175, 448, 1310, 453, 1440, 468);
      }
    }

    // Generate 470+ Tapered Grass Blades Rooted Directly Into the Hill Contour
    function generateHillGrass() {
      const grassGroup = document.getElementById('hill-grass-blades');
      if (!grassGroup) return;

      const svgNS = 'http://www.w3.org/2000/svg';
      const fragment = document.createDocumentFragment();
      const totalBlades = 475;

      for (let i = 0; i < totalBlades; i++) {
        const x = (i / totalBlades) * 1440 + (Math.sin(i * 17.3) * 1.4);
        const baseY = getHillYAtX(x) + 2.5; // Rooted 2.5px inside the hill silhouette so nothing floats

        // Slightly shorter grass directly beneath the girl's boots (x: 1105..1182)
        const nearFeet = x >= 1104 && x <= 1184;
        const height = nearFeet
          ? 5 + (Math.abs(Math.sin(i * 11.7)) * 5)
          : 7 + (Math.abs(Math.sin(i * 7.9 + 1.2)) * 9.5);

        const lean = Math.sin(i * 3.7) * 3.2 - 0.8;
        const halfBase = 1.05 + (i % 3) * 0.25;

        const blade = document.createElementNS(svgNS, 'path');
        const tipX = (x + lean).toFixed(1);
        const tipY = (baseY - height).toFixed(1);
        const leftX = (x - halfBase).toFixed(1);
        const rightX = (x + halfBase).toFixed(1);
        const rootY = (baseY + 2).toFixed(1);

        blade.setAttribute('d', `M ${leftX} ${rootY} Q ${x.toFixed(1)} ${(baseY - height * 0.55).toFixed(1)}, ${tipX} ${tipY} Q ${(x + halfBase * 0.5).toFixed(1)} ${(baseY - height * 0.45).toFixed(1)}, ${rightX} ${rootY} Z`);
        fragment.appendChild(blade);
      }

      grassGroup.appendChild(fragment);
    }

    // 4. Constellation Hover Line Highlight
    function highlightConstellation(active) {
      const wrapper = document.getElementById('constellation-wrapper');
      if (!wrapper) return;
      if (active) {
        wrapper.classList.add('constellation-active');
      } else {
        wrapper.classList.remove('constellation-active');
      }
    }

    // 5. Starlight Transition & Page Navigation
    const pageLabels = {
      home: 'Returning to the night sky...',
      about: 'Following Dubhe · About Me',
      projects: 'Following Merak · Projects',
      skills: 'Following Megrez · Skills',
      experience: 'Following Phecda · Experience',
      contact: 'Following Alkaid · Contact'
    };

    function navigateTo(target) {
      const veil = document.getElementById('transition-veil');
      const label = document.getElementById('transition-label');
      const homeView = document.getElementById('view-home');
      const subpageShell = document.getElementById('subpage-shell');

      if (label) {
        label.textContent = pageLabels[target] || 'Following star...';
      }

      veil.classList.add('active');

      setTimeout(() => {
        if (target === 'home') {
          subpageShell.classList.add('hidden');
          homeView.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'instant' });
        } else {
          homeView.classList.add('hidden');
          subpageShell.classList.remove('hidden');

          // Hide all subpages, show selected one
          document.querySelectorAll('.subpage-view').forEach((sec) => {
            sec.classList.add('hidden');
            sec.classList.remove('view-enter');
          });

          const activePage = document.getElementById(`page-${target}`);
          if (activePage) {
            activePage.classList.remove('hidden');
            void activePage.offsetWidth; // trigger reflow for animation
            activePage.classList.add('view-enter');
          }

          // Update active pill styling in sticky nav
          document.querySelectorAll('.sub-nav-pill').forEach((pill) => {
            if (pill.dataset.nav === target) {
              pill.classList.add('bg-peach', 'text-[#090c1e]', 'font-semibold');
              pill.classList.remove('text-offwhite/75', 'hover:text-peach');
            } else {
              pill.classList.remove('bg-peach', 'text-[#090c1e]', 'font-semibold');
              pill.classList.add('text-offwhite/75', 'hover:text-peach');
            }
          });

          window.scrollTo({ top: 0, behavior: 'instant' });
        }

        // Update URL hash cleanly without jumping
        try {
          history.replaceState(null, '', target === 'home' ? '#home' : `#${target}`);
        } catch (e) {}

        setTimeout(() => {
          veil.classList.remove('active');
        }, 160);
      }, 280);
    }

    // 6. Toast Notification Helper (Replaces alert())
    let toastTimer = null;
    function showToast(message) {
      const box = document.getElementById('toast-box');
      const msg = document.getElementById('toast-message');
      if (!box || !msg) return;

      msg.textContent = message;
      box.classList.remove('hidden');
      requestAnimationFrame(() => {
        box.classList.remove('translate-y-4', 'opacity-0');
      });

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        box.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => box.classList.add('hidden'), 300);
      }, 3400);
    }

    // 7. Contact Form & Clipboard Handlers
    function handleContactSubmit(event) {
      event.preventDefault();
      const nameInput = document.getElementById('contact-name');
      const sender = nameInput && nameInput.value ? nameInput.value.trim() : 'friend';
      showToast(`Thank you, ${sender}! Your message has been sent.`);
      event.target.reset();
    }

    function copyEmailToClipboard() {
      const email = 'hello@celinechiang.design';
      const tempInput = document.createElement('input');
      tempInput.value = email;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        showToast(`Copied ${email} to clipboard!`);
      } catch (err) {
        showToast(`Email: ${email}`);
      }
      document.body.removeChild(tempInput);
    }

    // 8. Initialize on Window Load
    window.addEventListener('DOMContentLoaded', () => {
      populateStarfield('home-starfield', 120);
      populateStarfield('subpage-starfield', 65);
      generateHillGrass();

      // Periodic subtle shooting star
      setTimeout(triggerShootingStar, 2400);
      setInterval(triggerShootingStar, 7500);

      // Respect deep link hash if present (defaulting to #home)
      const initialHash = window.location.hash.replace('#', '').toLowerCase();
      if (['about', 'projects', 'skills', 'experience', 'contact'].includes(initialHash)) {
        navigateTo(initialHash);
      }
    });
  </script>
