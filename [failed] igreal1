              <div class="mt-6 space-y-3">
                <button
                  onclick="copyEmailToClipboard()"
                  class="flex w-full items-center justify-between rounded-2xl border border-offwhite/15 bg-white/5 px-4 py-3.5 text-left text-sm text-offwhite transition-colors hover:border-peach/50 hover:text-peach cursor-pointer"
                >
                  <span>hello@celinechiang.design</span>
                  <span class="rounded-lg bg-peach/15 px-2.5 py-1 text-xs font-medium text-peach">Copy</span>
                </button>

                <a
                  href="https://www.instagram.com/wfuhumanities/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex w-full items-center justify-between rounded-2xl border border-offwhite/15 bg-white/5 px-4 py-3.5 text-sm text-offwhite transition-colors hover:border-peach/50 hover:text-peach"
                >
                  <span>Instagram (@wfuhumanities)</span>
                  <span class="text-xs text-offwhite/50">↗</span>
                </a>

                <a
                  href="https://www.linkedin.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex w-full items-center justify-between rounded-2xl border border-offwhite/15 bg-white/5 px-4 py-3.5 text-sm text-offwhite transition-colors hover:border-peach/50 hover:text-peach"
