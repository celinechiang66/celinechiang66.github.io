  <!-- ===================================================================== -->
  <script>
    // 1. Generate Procedural Twinkling Starfield
    function populateStarfield(containerId, count, maxTopPercent) {
      const container = document.getElementById(containerId);
      if (!container) return;

      const fragment = document.createDocumentFragment();
      for (let i = 0; i < count; i++) {
        const star = document.createElement("span");
        star.className = "bg-star";

        const size = (Math.random() * 2.2 + 0.8).toFixed(2);
        const left = (Math.random() * 100).toFixed(2);
        const top = (Math.random() * maxTopPercent).toFixed(2);
        const duration = (Math.random() * 4.5 + 2.5).toFixed(2);
        const delay = (Math.random() * 5).toFixed(2);
        const minOp = (Math.random() * 0.25 + 0.12).toFixed(2);
        const maxOp = (Math.random() * 0.45 + 0.55).toFixed(2);

        star.style.width = `${size}px`;
        star.style.height = `${size}px`;
        star.style.left = `${left}%`;
        star.style.top = `${top}%`;
        star.style.setProperty("--dur", `${duration}s`);
        star.style.setProperty("--delay", `${delay}s`);
        star.style.setProperty("--min-op", minOp);
        star.style.setProperty("--max-op", maxOp);

        fragment.appendChild(star);
      }
      container.appendChild(fragment);
    }

    // 2. Periodic Subtle Shooting Star across the Twilight Sky
    function triggerShootingStar() {
      const container = document.getElementById("shooting-star-container");
      const homeView = document.getElementById("home-view");
      if (!container || homeView.classList.contains("hidden")) return;

      const meteor = document.createElement("div");
      meteor.className = "shooting-star";
      meteor.style.left = `${55 + Math.random() * 40}%`;
      meteor.style.top = `${6 + Math.random() * 24}%`;
      container.appendChild(meteor);

      setTimeout(() => {
        meteor.remove();
      }, 1700);
    }

    // 3. Generate 475 Quadratic Bezier-Rooted Grass Blades along the Hill Horizon
    function generateHillGrass() {
      const grassGroup = document.getElementById("hill-grass-blades");
      if (!grassGroup) return;

      const svgNS = "http://www.w3.org/2000/svg";
      const totalBlades = 475;

      // Piecewise quadratic Bezier segments matching the rolling hill horizon path:
      // Segment 1: (0,492) -> Q(420,486) -> (780,464)
      // Segment 2: (780,464) -> Q(1060,444) -> (1175,448)
      // Segment 3: (1175,448) -> Q(1310,453) -> (1440,468)
      function getHillPoint(x) {
        if (x <= 780) {
          const t = x / 780;
          const y =
            (1 - t) * (1 - t) * 492 +
            2 * (1 - t) * t * 486 +
            t * t * 464;
          return { x, y };
        } else if (x <= 1175) {
          const t = (x - 780) / (1175 - 780);
          const y =
            (1 - t) * (1 - t) * 464 +
            2 * (1 - t) * t * 444 +
            t * t * 448;
          return { x, y };
        } else {
          const t = (x - 1175) / (1440 - 1175);
          const y =
            (1 - t) * (1 - t) * 448 +
            2 * (1 - t) * t * 453 +
            t * t * 468;
          return { x, y };
        }
      }

      const fragment = document.createDocumentFragment();
      for (let i = 0; i < totalBlades; i++) {
        const x = (i / (totalBlades - 1)) * 1440 + (Math.random() - 0.5) * 2.5;
        const clampedX = Math.max(0, Math.min(1440, x));
        const { y } = getHillPoint(clampedX);

        const height = 6 + Math.random() * 14;
        const lean = (Math.random() - 0.42) * 11;
        const baseHalfWidth = 0.9 + Math.random() * 1.1;

        const blade = document.createElementNS(svgNS, "path");
        const d = `M ${(clampedX - baseHalfWidth).toFixed(1)} ${(y + 2).toFixed(1)} ` +
                  `Q ${(clampedX + lean * 0.45).toFixed(1)} ${(y - height * 0.55).toFixed(1)}, ` +
                  `${(clampedX + lean).toFixed(1)} ${(y - height).toFixed(1)} ` +
                  `Q ${(clampedX + lean * 0.55 + baseHalfWidth * 0.6).toFixed(1)} ${(y - height * 0.45).toFixed(1)}, ` +
                  `${(clampedX + baseHalfWidth).toFixed(1)} ${(y + 2).toFixed(1)} Z`;

        blade.setAttribute("d", d);
        fragment.appendChild(blade);
      }

      grassGroup.appendChild(fragment);
    }

    // 4. Highlight Big Dipper Constellation Lines on Star Hover
    function highlightConstellation(active) {
      const wrapper = document.getElementById("constellation-wrapper");
      if (!wrapper) return;
      wrapper.classList.toggle("constellation-active", active);
    }

    // 5. Starlight Transition & Page Router
    const pageNames = {
      home: "Returning to Night Sky...",
      about: "Following Dubhe · About Me...",
      projects: "Following Merak · Projects...",
      skills: "Following Megrez · Skills...",
      experience: "Following Phecda · Experience...",
      contact: "Following Alkaid · Contact..."
    };

    function navigateTo(route) {
      const veil = document.getElementById("transition-veil");
      const label = document.getElementById("transition-label");
      const homeView = document.getElementById("home-view");
      const subpageShell = document.getElementById("subpage-shell");

      if (label) {
        label.textContent = pageNames[route] || "Following star...";
      }

      veil.classList.add("active");

      setTimeout(() => {
        if (route === "home") {
          subpageShell.classList.add("hidden");
          homeView.classList.remove("hidden");
          homeView.classList.add("view-enter");
          window.scrollTo({ top: 0, behavior: "instant" });
          history.replaceState(null, "", "#home");
        } else {
          homeView.classList.add("hidden");
          subpageShell.classList.remove("hidden");

          // Hide all subpages
          document.querySelectorAll(".subpage-view").forEach((el) => {
            el.classList.add("hidden");
            el.classList.remove("view-enter");
          });

          // Show target subpage
          const targetSection = document.getElementById(`page-${route}`);
          if (targetSection) {
            targetSection.classList.remove("hidden");
            targetSection.classList.add("view-enter");
          }

          // Update active pill styling in sticky nav
          document.querySelectorAll(".sub-nav-pill").forEach((pill) => {
            const isMatch = pill.getAttribute("data-nav") === route;
            pill.classList.toggle("bg-peach/20", isMatch);
            pill.classList.toggle("text-peach", isMatch);
            pill.classList.toggle("border", isMatch);
            pill.classList.toggle("border-peach/40", isMatch);
            pill.classList.toggle("text-offwhite/75", !isMatch);
          });

          window.scrollTo({ top: 0, behavior: "instant" });
          history.replaceState(null, "", `#${route}`);

          if (route === "contact" && typeof window.LIRenderAll === "function") {
            setTimeout(() => {
              try {
                window.LIRenderAll();
              } catch (e) {
                // Ignore if LinkedIn badge script is still initializing
              }
            }, 120);
          }
        }

        setTimeout(() => {
          veil.classList.remove("active");
        }, 220);
      }, 320);
    }

    // 6. Toast Notification Helper
    let toastTimeout;
    function showToast(message) {
      const box = document.getElementById("toast-box");
      const text = document.getElementById("toast-message");
      if (!box || !text) return;

      text.textContent = message;
      box.classList.remove("hidden");

      requestAnimationFrame(() => {
        box.classList.remove("translate-y-4", "opacity-0");
      });

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        box.classList.add("translate-y-4", "opacity-0");
        setTimeout(() => box.classList.add("hidden"), 300);
      }, 3200);
    }

    // 7. Contact Form & Email Copy Handlers
    function handleContactSubmit(event) {
      event.preventDefault();
      const nameInput = document.getElementById("contact-name");
      const senderName = nameInput && nameInput.value ? nameInput.value.trim() : "Friend";
      showToast(`Thank you, ${senderName}! Your message has been sent across the night sky.`);
      event.target.reset();
    }

    function copyEmail() {
      const email = "sc11296@nyu.edu";
      const tempInput = document.createElement("input");
      tempInput.value = email;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand("copy");
        showToast("Copied sc11296@nyu.edu to clipboard!");
      } catch (err) {
        showToast("Email: sc11296@nyu.edu");
      }
      document.body.removeChild(tempInput);
    }

    function reloadLinkedInBadge() {
      if (typeof window.LIRenderAll === "function") {
        try {
          window.LIRenderAll();
          showToast("Reloading LinkedIn profile badge...");
          return;
        } catch (err) {
          // Fallback to opening profile toast if blocked
        }
      }
      showToast("LinkedIn preview refreshed (linkedin.com/in/celine-chiang-043717345)");
    }

    // 7b. Reload Individual Instagram Reel Player Iframe
    function reloadReelIframe(iframeId) {
      const iframe = document.getElementById(iframeId);
      if (!iframe) return;
      const currentSrc = iframe.src;
      iframe.src = "";
      requestAnimationFrame(() => {
        iframe.src = currentSrc;
      });
      showToast("Reloading Instagram Reel player...");
    }

    // 7c. Collapse / Expand Experience Group Sections
    function toggleExperienceGroup(groupId, btn) {
      const group = document.getElementById(groupId);
      if (!group || !btn) return;

      const isCurrentlyExpanded = btn.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isCurrentlyExpanded;

      btn.setAttribute("aria-expanded", String(nextExpanded));
      group.classList.toggle("hidden", !nextExpanded);

      const chevron = btn.querySelector(".exp-chevron");
      if (chevron) {
        chevron.classList.toggle("-rotate-90", !nextExpanded);
      }
    }

    // 8. Initialize Starfields, Grass, Shooting Stars & URL Hash Route
    window.addEventListener("DOMContentLoaded", () => {
      populateStarfield("home-starfield", 95, 72);
      populateStarfield("subpage-starfield", 65, 100);
      generateHillGrass();

      setInterval(triggerShootingStar, 7500);
      setTimeout(triggerShootingStar, 1800);

      const initialHash = window.location.hash.replace("#", "");
      if (["about", "projects", "skills", "experience", "contact"].includes(initialHash)) {
        navigateTo(initialHash);
      }
    });
  </script>
