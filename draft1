  <style type="text/tailwindcss">
    @theme {
      --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      --font-serif: "Cormorant Garamond", Georgia, serif;
      --color-midnight: #090c1e;
      --color-twilight: #1e2144;
      --color-dusk: #4b4875;
      --color-plum: #68557a;
      --color-rose: #d48c84;
      --color-peach: #e8a87c;
      --color-offwhite: #f5ece6;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background-color: #090c1e;
      color: #f5ece6;
      font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
    }

    /* Full Twilight Gradient */
    .twilight-sky {
      background: linear-gradient(
        180deg,
        #080b1c 0%,
        #131736 22%,
        #2d2e59 46%,
        #68557a 67%,
        #c58482 84%,
        #f2be9f 100%
      );
    }

    /* Subpage Deep Night Sky Background */
    .subpage-sky {
      background:
        radial-gradient(circle at 82% 14%, rgba(104, 85, 122, 0.28) 0%, transparent 45%),
        radial-gradient(circle at 14% 86%, rgba(232, 168, 124, 0.14) 0%, transparent 50%),
        linear-gradient(180deg, #080b1c 0%, #111530 55%, #1d1f42 100%);
    }

    /* Background Twinkling Stars */
    @keyframes twinkle {
      0%, 100% {
        opacity: var(--min-op, 0.25);
        transform: scale(0.9);
      }
      50% {
        opacity: var(--max-op, 0.95);
        transform: scale(1.15);
      }
    }

    .bg-star {
      position: absolute;
      border-radius: 9999px;
      background-color: #fffaf0;
      pointer-events: none;
      animation: twinkle var(--dur, 4s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }

    /* Shooting Star Keyframes */
    @keyframes shoot {
      0% {
        opacity: 0;
        transform: translate3d(0, 0, 0) rotate(-28deg) scaleX(0.3);
      }
      12% {
        opacity: 1;
        transform: translate3d(-60px, 32px, 0) rotate(-28deg) scaleX(1);
      }
      100% {
        opacity: 0;
        transform: translate3d(-420px, 225px, 0) rotate(-28deg) scaleX(0.2);
      }
    }

    .shooting-star {
      position: absolute;
      width: 130px;
      height: 1.5px;
      background: linear-gradient(90deg, rgba(255, 250, 240, 0.95), rgba(242, 190, 159, 0.35), transparent);
      border-radius: 9999px;
      filter: drop-shadow(0 0 6px rgba(255, 250, 240, 0.85));
      animation: shoot 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Constellation Interactive Star Glow */
    @keyframes starPulse {
      0%, 100% {
        box-shadow: 0 0 18px 6px rgba(255, 250, 235, 0.72), 0 0 36px 14px rgba(242, 190, 159, 0.32);
      }
      50% {
        box-shadow: 0 0 24px 9px rgba(255, 252, 242, 0.95), 0 0 48px 18px rgba(242, 190, 159, 0.48);
      }
    }

    .star-node-core {
      animation: starPulse 3.6s ease-in-out infinite;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.3s ease;
    }

    .star-trigger:hover .star-node-core,
    .star-trigger:focus-visible .star-node-core {
      transform: scale(1.45);
      background-color: #ffffff;
    }

    .star-label {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease, text-shadow 0.3s ease;
      text-shadow: 0 2px 12px rgba(9, 12, 30, 0.85);
    }

    .star-trigger:hover .star-label,
    .star-trigger:focus-visible .star-label {
      color: #f8d0b0;
      transform: translateY(3px) scale(1.06);
      text-shadow: 0 0 18px rgba(242, 190, 159, 0.85);
    }

    /* Subtle Dash Flow on Constellation Lines when hovered */
    @keyframes dashFlow {
      to {
        stroke-dashoffset: -24;
      }
    }

    .constellation-active .constellation-line {
      stroke: rgba(255, 248, 235, 0.85);
      animation: dashFlow 1.8s linear infinite;
    }

    /* Gentle Hair & Dress Breeze Sway */
    @keyframes breezeSway {
      0%, 100% {
        transform: rotate(0deg) translateX(0px);
      }
      50% {
        transform: rotate(1.4deg) translateX(2px);
      }
    }

    .wind-sway {
      transform-origin: 79% 68%;
      animation: breezeSway 5.5s ease-in-out infinite;
    }

    /* Starlight Warp / Page Transition Overlay */
    #transition-veil {
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #transition-veil.active {
      opacity: 1;
      pointer-events: all;
    }

    /* Page View Fade-Up Entrance */
    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .view-enter {
      animation: pageFadeIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Glassmorphism Cards for Subpages */
    .glass-card {
      background: rgba(20, 24, 52, 0.62);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(245, 236, 230, 0.12);
      box-shadow: 0 18px 40px -15px rgba(4, 6, 18, 0.7);
    }

    .glass-card-hover {
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card-hover:hover {
      transform: translateY(-4px);
      border-color: rgba(232, 168, 124, 0.42);
      box-shadow: 0 22px 45px -12px rgba(232, 168, 124, 0.14);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #080b1c;
    }
    ::-webkit-scrollbar-thumb {
      background: #2f335c;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #e8a87c;
    }
  </style>
</head>
<body class="antialiased selection:bg-peach/30 selection:text-offwhite">

  <!-- Starlight Burst Transition Overlay -->
